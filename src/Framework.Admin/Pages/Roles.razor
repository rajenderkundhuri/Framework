@page "/roles"
@attribute [Authorize]
@inject IRoleApiService RoleApiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Roles</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Role Management</MudText>

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudStack Row="true" Spacing="2">
            <MudTextField @bind-Value="_searchTerm" Placeholder="Search roles..." Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true" OnKeyUp="@(async e => { if (e.Key == "Enter") await LoadRolesAsync(); })"
                          Class="mr-2" Style="width: 300px;" />
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadRolesAsync"
                       StartIcon="@Icons.Material.Filled.Refresh">Search</MudButton>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog"
                   StartIcon="@Icons.Material.Filled.Add">Add Role</MudButton>
    </MudStack>

    <MudTable @ref="_table" T="RoleListResponse" ServerData="@ServerReload" Dense="true" Hover="true"
              Loading="_loading" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortLabel="Name" T="RoleListResponse">Name</MudTableSortLabel></MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Users</MudTh>
            <MudTh>Permissions</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">
                @context.Name
                @if (context.IsDefault)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">Default</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Users">@context.UserCount</MudTd>
            <MudTd DataLabel="Permissions">@context.PermissionCount</MudTd>
            <MudTd DataLabel="Type">
                @if (context.IsSystem)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">System</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Custom</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenEditDialog(context))" Disabled="@context.IsSystem" />
                <MudIconButton Icon="@Icons.Material.Filled.Security" Size="Size.Small" Color="Color.Info"
                               OnClick="@(() => OpenPermissionsDialog(context))" Disabled="@context.IsSystem" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteRoleAsync(context))" Disabled="@context.IsSystem" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50}" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<RoleListResponse>? _table;
    private bool _loading;
    private string _searchTerm = "";

    private async Task<TableData<RoleListResponse>> ServerReload(TableState state, CancellationToken token)
    {
        _loading = true;

        var request = new RoleListRequest
        {
            SearchTerm = _searchTerm,
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SortBy = state.SortLabel ?? "Name",
            SortDescending = state.SortDirection == SortDirection.Descending
        };

        var result = await RoleApiService.GetRolesAsync(request);

        _loading = false;

        if (result.IsSuccess && result.Value != null)
        {
            return new TableData<RoleListResponse> { Items = result.Value.Items, TotalItems = result.Value.TotalCount };
        }

        return new TableData<RoleListResponse> { Items = Array.Empty<RoleListResponse>(), TotalItems = 0 };
    }

    private async Task LoadRolesAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<RoleDialog>("Create Role");
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadRolesAsync();
            Snackbar.Add("Role created successfully", Severity.Success);
        }
    }

    private async Task OpenEditDialog(RoleListResponse role)
    {
        var parameters = new DialogParameters { ["RoleId"] = role.Id };
        var dialog = await DialogService.ShowAsync<RoleDialog>("Edit Role", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadRolesAsync();
            Snackbar.Add("Role updated successfully", Severity.Success);
        }
    }

    private async Task OpenPermissionsDialog(RoleListResponse role)
    {
        var parameters = new DialogParameters { ["RoleId"] = role.Id, ["RoleName"] = role.Name };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RolePermissionsDialog>("Manage Permissions", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadRolesAsync();
        }
    }

    private async Task DeleteRoleAsync(RoleListResponse role)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Deletion",
            $"Are you sure you want to delete role '{role.Name}'?",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            var result = await RoleApiService.DeleteRoleAsync(role.Id);
            if (result.IsSuccess)
            {
                await LoadRolesAsync();
                Snackbar.Add("Role deleted successfully", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Error ?? "Failed to delete role", Severity.Error);
            }
        }
    }
}
