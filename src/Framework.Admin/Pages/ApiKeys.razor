@page "/api-keys"
@attribute [Authorize]
@inject IApiKeyApiService ApiKeyApiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>API Keys</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">API Key Management</MudText>

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudStack Row="true" Spacing="2">
            <MudSelect T="bool?" @bind-Value="_isActiveFilter" Label="Status" Variant="Variant.Outlined"
                       Dense="true" Style="width: 150px;">
                <MudSelectItem T="bool?" Value="@((bool?)null)">All</MudSelectItem>
                <MudSelectItem T="bool?" Value="@true">Active</MudSelectItem>
                <MudSelectItem T="bool?" Value="@false">Revoked</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadDataAsync"
                       StartIcon="@Icons.Material.Filled.Refresh">Refresh</MudButton>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog"
                   StartIcon="@Icons.Material.Filled.Add">Create API Key</MudButton>
    </MudStack>

    <MudTable @ref="_table" T="ApiKeyResponse" ServerData="@ServerReload" Dense="true" Hover="true"
              Loading="_loading" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Key Prefix</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Expires</MudTh>
            <MudTh>Last Used</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Key Prefix">
                <code>@context.KeyPrefix...</code>
            </MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsActive)
                {
                    @if (context.ExpiresAt.HasValue && context.ExpiresAt.Value < DateTimeOffset.UtcNow)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Expired</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Active</MudChip>
                    }
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Revoked</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
            <MudTd DataLabel="Expires">@(context.ExpiresAt?.ToLocalTime().ToString("g") ?? "Never")</MudTd>
            <MudTd DataLabel="Last Used">@(context.LastUsedAt?.ToLocalTime().ToString("g") ?? "Never")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => OpenEditDialog(context))" />
                @if (context.IsActive)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Warning"
                                   OnClick="@(() => RevokeAsync(context))" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<ApiKeyResponse>? _table;
    private bool _loading;
    private bool? _isActiveFilter;

    private async Task<TableData<ApiKeyResponse>> ServerReload(TableState state, CancellationToken token)
    {
        _loading = true;

        var request = new ApiKeyListRequest
        {
            IsActive = _isActiveFilter,
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SortBy = state.SortLabel ?? "CreatedAt",
            SortDescending = state.SortDirection == SortDirection.Descending || state.SortDirection == SortDirection.None
        };

        var result = await ApiKeyApiService.GetAllApiKeysAsync(request);

        _loading = false;

        if (result.IsSuccess && result.Value != null)
        {
            return new TableData<ApiKeyResponse> { Items = result.Value.Items, TotalItems = result.Value.TotalCount };
        }

        return new TableData<ApiKeyResponse> { Items = Array.Empty<ApiKeyResponse>(), TotalItems = 0 };
    }

    private async Task LoadDataAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ApiKeyDialog>("Create API Key", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateApiKeyResponse apiKey)
        {
            await LoadDataAsync();

            // Show the created API key
            var parameters = new DialogParameters
            {
                ["ApiKey"] = apiKey.ApiKey,
                ["Name"] = apiKey.Name
            };
            await DialogService.ShowAsync<ApiKeyCreatedDialog>("API Key Created", parameters,
                new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        }
    }

    private async Task OpenEditDialog(ApiKeyResponse apiKey)
    {
        var parameters = new DialogParameters { ["ApiKeyId"] = apiKey.Id };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ApiKeyDialog>("Edit API Key", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
            Snackbar.Add("API key updated successfully", Severity.Success);
        }
    }

    private async Task RevokeAsync(ApiKeyResponse apiKey)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Revocation",
            $"Are you sure you want to revoke API key '{apiKey.Name}'? This action cannot be undone.",
            yesText: "Revoke", cancelText: "Cancel");

        if (confirmed == true)
        {
            var result = await ApiKeyApiService.RevokeAsync(apiKey.Id);
            if (result.IsSuccess)
            {
                await LoadDataAsync();
                Snackbar.Add("API key revoked successfully", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Error ?? "Failed to revoke API key", Severity.Error);
            }
        }
    }

    private async Task DeleteAsync(ApiKeyResponse apiKey)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Deletion",
            $"Are you sure you want to delete API key '{apiKey.Name}'? This action cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            var result = await ApiKeyApiService.DeleteAsync(apiKey.Id);
            if (result.IsSuccess)
            {
                await LoadDataAsync();
                Snackbar.Add("API key deleted successfully", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Error ?? "Failed to delete API key", Severity.Error);
            }
        }
    }
}
