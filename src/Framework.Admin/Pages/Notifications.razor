@page "/notifications"
@attribute [Authorize]
@inject INotificationApiService NotificationApiService
@inject IUserApiService UserApiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Notifications</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Notification Management</MudText>

<MudPaper Class="pa-4" Elevation="2">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudStack Row="true" Spacing="2">
            <MudSelect T="bool?" @bind-Value="_isReadFilter" Label="Read Status" Variant="Variant.Outlined"
                       Dense="true" Style="width: 150px;">
                <MudSelectItem T="bool?" Value="@((bool?)null)">All</MudSelectItem>
                <MudSelectItem T="bool?" Value="@true">Read</MudSelectItem>
                <MudSelectItem T="bool?" Value="@false">Unread</MudSelectItem>
            </MudSelect>
            <MudSelect T="NotificationSeverity?" @bind-Value="_severityFilter" Label="Severity" Variant="Variant.Outlined"
                       Dense="true" Style="width: 150px;">
                <MudSelectItem T="NotificationSeverity?" Value="@((NotificationSeverity?)null)">All</MudSelectItem>
                @foreach (NotificationSeverity severity in Enum.GetValues(typeof(NotificationSeverity)))
                {
                    <MudSelectItem T="NotificationSeverity?" Value="@severity">@severity</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadDataAsync"
                       StartIcon="@Icons.Material.Filled.Refresh">Search</MudButton>
        </MudStack>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateDialog"
                   StartIcon="@Icons.Material.Filled.Add">Send Notification</MudButton>
    </MudStack>

    <MudTable @ref="_table" T="NotificationResponse" ServerData="@ServerReload" Dense="true" Hover="true"
              Loading="_loading" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>Title</MudTh>
            <MudTh>Message</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Severity</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Created</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Title">@context.Title</MudTd>
            <MudTd DataLabel="Message">
                @if (context.Message.Length > 50)
                {
                    @context.Message.Substring(0, 50)@("...")
                }
                else
                {
                    @context.Message
                }
            </MudTd>
            <MudTd DataLabel="Type">
                <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.Type</MudChip>
            </MudTd>
            <MudTd DataLabel="Severity">
                <MudChip T="string" Size="Size.Small" Color="@GetSeverityColor(context.Severity)">@context.Severity</MudChip>
            </MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsRead)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default">Read</MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Unread</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Created">@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                               OnClick="@(() => ViewDetails(context))" />
                @if (!context.IsRead)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Small" Color="Color.Success"
                                   OnClick="@(() => MarkAsReadAsync(context))" />
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.MarkEmailUnread" Size="Size.Small" Color="Color.Warning"
                                   OnClick="@(() => MarkAsUnreadAsync(context))" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteAsync(context))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[]{10, 25, 50, 100}" />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<NotificationResponse>? _table;
    private bool _loading;
    private bool? _isReadFilter;
    private NotificationSeverity? _severityFilter;

    private async Task<TableData<NotificationResponse>> ServerReload(TableState state, CancellationToken token)
    {
        _loading = true;

        var request = new NotificationListRequest
        {
            IsRead = _isReadFilter,
            Severity = _severityFilter,
            PageNumber = state.Page + 1,
            PageSize = state.PageSize,
            SortDescending = true
        };

        var result = await NotificationApiService.GetNotificationsAsync(request);

        _loading = false;

        if (result.IsSuccess && result.Value != null)
        {
            return new TableData<NotificationResponse> { Items = result.Value.Items, TotalItems = result.Value.TotalCount };
        }

        return new TableData<NotificationResponse> { Items = Array.Empty<NotificationResponse>(), TotalItems = 0 };
    }

    private async Task LoadDataAsync()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private Color GetSeverityColor(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Info => Color.Info,
        NotificationSeverity.Success => Color.Success,
        NotificationSeverity.Warning => Color.Warning,
        NotificationSeverity.Error => Color.Error,
        _ => Color.Default
    };

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<NotificationDialog>("Send Notification",
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
            Snackbar.Add("Notification sent successfully", Severity.Success);
        }
    }

    private async Task ViewDetails(NotificationResponse notification)
    {
        var parameters = new DialogParameters { ["Notification"] = notification };
        await DialogService.ShowAsync<NotificationDetailDialog>("Notification Details", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    private async Task MarkAsReadAsync(NotificationResponse notification)
    {
        var result = await NotificationApiService.MarkAsReadAsync(notification.Id);
        if (result.IsSuccess)
        {
            await LoadDataAsync();
            Snackbar.Add("Notification marked as read", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.Error ?? "Failed to mark as read", Severity.Error);
        }
    }

    private async Task MarkAsUnreadAsync(NotificationResponse notification)
    {
        var result = await NotificationApiService.MarkAsUnreadAsync(notification.Id);
        if (result.IsSuccess)
        {
            await LoadDataAsync();
            Snackbar.Add("Notification marked as unread", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.Error ?? "Failed to mark as unread", Severity.Error);
        }
    }

    private async Task DeleteAsync(NotificationResponse notification)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Confirm Deletion",
            $"Are you sure you want to delete this notification?",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            var result = await NotificationApiService.DeleteAsync(notification.Id);
            if (result.IsSuccess)
            {
                await LoadDataAsync();
                Snackbar.Add("Notification deleted successfully", Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Error ?? "Failed to delete notification", Severity.Error);
            }
        }
    }
}
