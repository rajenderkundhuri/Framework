@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">API Key Created</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Make sure to copy your API key now. You won't be able to see it again!
        </MudAlert>

        <MudText Typo="Typo.caption" Color="Color.Secondary">Name</MudText>
        <MudText Typo="Typo.body1" Class="mb-3">@Name</MudText>

        <MudText Typo="Typo.caption" Color="Color.Secondary">API Key</MudText>
        <MudPaper Class="pa-3 d-flex align-center justify-space-between" Elevation="0" Outlined="true">
            <code style="word-break: break-all;">@ApiKey</code>
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Primary"
                           OnClick="CopyToClipboard" />
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Close">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    [Parameter] public string ApiKey { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    private void Close() => MudDialog?.Close();

    private async Task CopyToClipboard()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", ApiKey);
            Snackbar.Add("API key copied to clipboard", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to copy to clipboard", Severity.Error);
        }
    }
}
