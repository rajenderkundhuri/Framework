using System.Net.Http.Json;
using Framework.Application.Common.Models;
using {{ application_namespace }}.{{ entity_plural }};

namespace Framework.Admin.Services;

public interface I{{ entity_name }}ApiService
{
    Task<Result<PagedList<{{ entity_name }}ListResponse>>> Get{{ entity_plural }}Async({{ entity_name }}ListRequest request);
    Task<Result<{{ entity_name }}DetailResponse>> Get{{ entity_name }}ByIdAsync(Guid id);
    Task<Result<Guid>> Create{{ entity_name }}Async(Create{{ entity_name }}Request request);
    Task<Result> Update{{ entity_name }}Async(Guid id, Update{{ entity_name }}Request request);
    Task<Result> Delete{{ entity_name }}Async(Guid id);
}

public class {{ entity_name }}ApiService : I{{ entity_name }}ApiService
{
    private readonly HttpClient _httpClient;

    public {{ entity_name }}ApiService(IHttpClientFactory httpClientFactory)
    {
        _httpClient = httpClientFactory.CreateClient("API");
    }

    public async Task<Result<PagedList<{{ entity_name }}ListResponse>>> Get{{ entity_plural }}Async({{ entity_name }}ListRequest request)
    {
        try
        {
            var query = BuildQueryString(request);
            var response = await _httpClient.GetFromJsonAsync<PagedList<{{ entity_name }}ListResponse>>($"api/{{ route_path }}{query}");
            return response != null
                ? Result<PagedList<{{ entity_name }}ListResponse>>.Success(response)
                : Result<PagedList<{{ entity_name }}ListResponse>>.Failure("Failed to get {{ entity_plural | string.downcase }}", "API_ERROR");
        }
        catch (Exception ex)
        {
            return Result<PagedList<{{ entity_name }}ListResponse>>.Failure(ex.Message, "API_ERROR");
        }
    }

    public async Task<Result<{{ entity_name }}DetailResponse>> Get{{ entity_name }}ByIdAsync(Guid id)
    {
        try
        {
            var response = await _httpClient.GetFromJsonAsync<{{ entity_name }}DetailResponse>($"api/{{ route_path }}/{id}");
            return response != null
                ? Result<{{ entity_name }}DetailResponse>.Success(response)
                : Result<{{ entity_name }}DetailResponse>.NotFound("{{ entity_name }} not found");
        }
        catch (Exception ex)
        {
            return Result<{{ entity_name }}DetailResponse>.Failure(ex.Message, "API_ERROR");
        }
    }

    public async Task<Result<Guid>> Create{{ entity_name }}Async(Create{{ entity_name }}Request request)
    {
        try
        {
            var response = await _httpClient.PostAsJsonAsync("api/{{ route_path }}", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Guid>();
                return Result<Guid>.Success(result);
            }
            var error = await response.Content.ReadAsStringAsync();
            return Result<Guid>.Failure(error, "API_ERROR");
        }
        catch (Exception ex)
        {
            return Result<Guid>.Failure(ex.Message, "API_ERROR");
        }
    }

    public async Task<Result> Update{{ entity_name }}Async(Guid id, Update{{ entity_name }}Request request)
    {
        try
        {
            var response = await _httpClient.PutAsJsonAsync($"api/{{ route_path }}/{id}", request);
            return response.IsSuccessStatusCode
                ? Result.Success()
                : Result.Failure(await response.Content.ReadAsStringAsync(), "API_ERROR");
        }
        catch (Exception ex)
        {
            return Result.Failure(ex.Message, "API_ERROR");
        }
    }

    public async Task<Result> Delete{{ entity_name }}Async(Guid id)
    {
        try
        {
            var response = await _httpClient.DeleteAsync($"api/{{ route_path }}/{id}");
            return response.IsSuccessStatusCode
                ? Result.Success()
                : Result.Failure(await response.Content.ReadAsStringAsync(), "API_ERROR");
        }
        catch (Exception ex)
        {
            return Result.Failure(ex.Message, "API_ERROR");
        }
    }

    private static string BuildQueryString({{ entity_name }}ListRequest request)
    {
        var query = new List<string>();

        if (!string.IsNullOrEmpty(request.SearchTerm))
            query.Add($"searchTerm={Uri.EscapeDataString(request.SearchTerm)}");
{{~ for prop in filter_properties ~}}
        if (request.{{ prop.name }}.HasValue)
            query.Add($"{{ prop.name | string.downcase }}={request.{{ prop.name }}}");
{{~ end ~}}
        query.Add($"pageNumber={request.PageNumber}");
        query.Add($"pageSize={request.PageSize}");
        query.Add($"sortBy={request.SortBy}");
        query.Add($"sortDescending={request.SortDescending}");

        return query.Count > 0 ? "?" + string.Join("&", query) : "";
    }
}

