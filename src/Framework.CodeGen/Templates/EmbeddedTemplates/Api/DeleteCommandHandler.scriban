using Framework.Application.Common.Commands;
using Framework.Application.Common.Models;
using Framework.Domain.Common.Interfaces;
using {{ domain_namespace }};

namespace {{ namespace }}.{{ entity_plural }}.Commands;

/// <summary>
/// Handler for Delete{{ entity_name }}Command
/// </summary>
public class Delete{{ entity_name }}CommandHandler : ICommandHandler<Delete{{ entity_name }}Command>
{
    private readonly IRepository<{{ entity_name }}> _repository;
    private readonly IUnitOfWork _unitOfWork;

    public Delete{{ entity_name }}CommandHandler(
        IRepository<{{ entity_name }}> repository,
        IUnitOfWork unitOfWork)
    {
        _repository = repository;
        _unitOfWork = unitOfWork;
    }

    public async Task<Result> Handle(Delete{{ entity_name }}Command request, CancellationToken cancellationToken)
    {
        var entity = await _repository.GetByIdAsync(request.Id, cancellationToken);

        if (entity == null)
        {
            return Result.NotFound($"{{ entity_name }} with ID {request.Id} not found");
        }

{{~ if is_soft_delete ~}}
        entity.SoftDelete(DateTimeOffset.UtcNow);
        _repository.Update(entity);
{{~ else ~}}
        _repository.Delete(entity);
{{~ end ~}}
        await _unitOfWork.SaveChangesAsync(cancellationToken);

        return Result.Success();
    }
}
